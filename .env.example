# ---------------------------------------------------------------
# CENA FIT — Gestão de Alunos
# Copie este arquivo para ".env.local" (desenvolvimento) ou
# configure as variáveis no painel da Vercel (produção).
# NUNCA versione o arquivo .env com valores reais.
# ---------------------------------------------------------------

# String de conexão com o PostgreSQL.
# Em produção use a fornecedora gerenciada (Vercel Postgres / Neon / Supabase)
# e TLS habilitado (sslmode=require).
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/cenafit?schema=public&sslmode=disable"

# Chave usada como "pepper" no hash de sessões e IPs.
# Gere uma valor forte e único, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="TROQUE_POR_UM_VALOR_ALEATORIO_FORTE"

# URL pública do sistema (usada para validação de origem/CSRF).
# Em produção: https://seu-dominio.vercel.app
APP_URL="http://localhost:3000"

# Define o ambiente. Produção ativa cookies Secure e mensagens de erro genéricas.
NODE_ENV="development"
